{
  "name": "resteam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api": "wrangler dev --local --port 8787",
    "db:seed": "node scripts/seed.ts",
    "db:local": "wrangler d1 migrations apply resteam --local",
    "deploy": "npm run build && wrangler deploy",
    "coverage": "node scripts/treemap.ts",
    "check:css": "node scripts/css-collisions.ts"
  },
  "dependencies": {
    "mobx": "^7.0.6",
    "mobx-react-lite": "^5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.151.1"
  }
}
