{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Copy to wrangler.jsonc, then run `wrangler d1 create resteam` and paste the id below.
  // Set CLOUDFLARE_ACCOUNT_ID in your shell if your login has several accounts.
  "name": "resteam",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/play/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "resteam",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "./migrations" }
  ],
  // Uploaded games live here: `wrangler r2 bucket create resteam-files`
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "resteam-files" }],
  // Moderators: comma-separated usernames. Leave empty until you have an account to moderate with.
  // Set REQUIRE_APPROVAL to "1" to hold new publications for review.
  "vars": { "ADMIN_USERNAMES": "", "REQUIRE_APPROVAL": "0" },
  "ratelimits": [
    // approximate and per Cloudflare location, which is fine for abuse protection
    { "name": "GENERAL_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "NEW_USER_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    // sign-in is throttled per IP and, separately, per account name so one account cannot be guessed at from many IPs
    { "name": "AUTH_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1005", "simple": { "limit": 8, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
  "observability": { "enabled": true }
}
